# TensuraLabs — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Required in production (>= 32 chars). Generate: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Set to 1 when running behind a reverse proxy (Nginx/Caddy/Cloudflare)
TRUST_PROXY=0
# Comma-separated list of allowed origins (optional)
ALLOWED_ORIGINS=

# --- Storage ------------------------------------------------------------
# Defaults: ./data/tensuralabs.db and ./data/uploads
DATABASE_PATH=
UPLOAD_DIR=

# --- Initial admin (seeded on first start) -------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Rate limits --------------------------------------------------------
RATE_LIMIT_LEADS=5
RATE_LIMIT_LOGIN=10

# --- Public contact links -----------------------------------------------
CONTACT_WHATSAPP=
CONTACT_GITHUB=
CONTACT_EMAIL=
CONTACT_LINKEDIN=
CONTACT_INSTAGRAM=
CONTACT_X=

# --- Outgoing webhooks (local testing only) -----------------------------
WEBHOOK_ALLOW_PRIVATE=0
WEBHOOK_ALLOW_HTTP=0

# --- Mail app -----------------------------------------------------------
MAIL_HOSTNAME=
MAIL_PUBLIC_URL=
SITE_PUBLIC_URL=
MAIL_DOMAINS=tensuralabs.app
# Shared with the Cloudflare Worker (>= 32 chars). Generate: openssl rand -hex 32
MAIL_WORKER_SECRET=
MAIL_WORKER_URL=
# none | cloudflare | resend
MAIL_PROVIDER=none
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MAIL_RATE_LIMIT_CREATE=10
MAIL_RATE_LIMIT_LOGIN=20
MAIL_RATE_LIMIT_SEND=30
MAIL_SESSION_DAYS=30
